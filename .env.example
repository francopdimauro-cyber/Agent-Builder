# --- IA (NVIDIA, API compatible con OpenAI) ---
# Clave gratuita en https://build.nvidia.com (empieza por nvapi-)
NVIDIA_API_KEY=
# Orden = prioridad. El primero es el principal; los siguientes son respaldo.
# Comprueba los identificadores exactos con:  npm run models
AI_MODELS=nvidia/nemotron-3-super-120b-a12b,nvidia/nemotron-3-ultra-550b-a55b,nvidia/nemotron-3.5-super-vl-120b-a12b
# Opcional: otra URL base compatible con OpenAI
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# --- Servidor ---
PORT=3000
HOST=127.0.0.1
DATABASE_PATH=./data/agent-factory.db

# --- Seguridad ---
ALLOW_REGISTRATION=true
SESSION_TTL_DAYS=14
# true si sirves la app por HTTPS (recomendado en producción)
COOKIE_SECURE=false
# Orígenes extra permitidos para peticiones con cookie (p. ej. un front en otro puerto), separados por comas
ALLOWED_ORIGINS=
